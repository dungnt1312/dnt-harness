+    await fs.writeFile(path.join(home, 'workspaces', wsId, 'CLAUDE.md'), `# rules\n${'fixed instruction text '.repeat(1_800)}`)
+    const { id } = await (await fetch(`${server.url}/api/workspaces/${wsId}/sessions`, { method: 'POST' })).json() as { id: string }
