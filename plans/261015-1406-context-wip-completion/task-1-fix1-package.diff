e792353 fix(context): compare duplicate attempt usage by value

diff --git a/src/harness/context/context-state.ts b/src/harness/context/context-state.ts
index 556ed34..09d1fd0 100644
--- a/src/harness/context/context-state.ts
+++ b/src/harness/context/context-state.ts
@@ -87,21 +87,22 @@ export function createContextReducer<M extends ManifestShape>(initialSessionId?:
           const f = event.fact
           if (f === undefined || f.state === 'start' || !isValidContextId(f.contextId) || !isValidTokenUsage(f.usage) || f.attribution === undefined) continue
           const entry = entries.get(f.contextId)
           if (entry === undefined || (entry.turnId !== undefined && entry.turnId !== f.attribution.turnId)
             || (entry.manifest.model !== undefined && f.model !== undefined && entry.manifest.model !== f.model)
             || (entry.manifest.provider !== undefined && f.provider !== undefined && entry.manifest.provider !== f.provider)) continue
           sessionId ??= f.attribution.sessionId
           if (f.attribution.sessionId !== sessionId) continue
           const seen = attempts.get(f.attemptId)
           if (seen !== undefined) {
-            if (JSON.stringify(seen) !== JSON.stringify(f.usage)) console.warn('conflicting usage for repeated attempt')
+            if (seen.inputTokens !== f.usage.inputTokens || seen.cachedInputTokens !== f.usage.cachedInputTokens
+              || seen.outputTokens !== f.usage.outputTokens) console.warn('conflicting usage for repeated attempt')
             continue
           }
           attempts.set(f.attemptId,{...f.usage})
           if (f.usage.cachedInputTokens !== undefined) {
             cacheableInputTokens += f.usage.inputTokens; cachedInputTokens += f.usage.cachedInputTokens
           }
           entry.last = {...f.usage}; entry.view = requestView(entry); changed.add(f.contextId)
           refreshCurrentTotals()
           continue
         }
