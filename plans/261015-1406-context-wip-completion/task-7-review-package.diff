 function isBareSleep(command: string): boolean {
   const tokens = command.trim().split(/\s+/)
   let index = 0
   while (index < tokens.length && /^[A-Za-z_][A-Za-z0-9_]*=/.test(tokens[index]!)) index += 1
   return tokens[index] === 'sleep'
 }
 
