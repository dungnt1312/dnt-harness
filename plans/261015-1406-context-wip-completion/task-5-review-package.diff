   if (tokens < 100_000) {
     const k = (tokens / 1000).toFixed(1)
     return `${k.endsWith('.0') ? k.slice(0, -2) : k}k`
   }
   if (tokens < 1_000_000) return `${Math.round(tokens / 1000)}k`
